<Project Sdk="Transpose.Build.Target/26.9.4870">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- CS1998 = async method without await; CA2007 = ConfigureAwait. Both are noise in
         transpiled front-end code, and the Curiosity projects disable them too. -->
    <NoWarn>CS1998,CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Curiosity.FrontEnd"       Version="26.11.8066" />
    <PackageReference Include="Curiosity.FrontEnd.Admin" Version="26.11.8066" />
    <PackageReference Include="Curiosity.FrontEnd.API"   Version="26.11.8066" />
    <PackageReference Include="Curiosity.FrontEnd.Core"  Version="26.11.8066" />
    <PackageReference Include="Transpose.BCL"            Version="26.11.7972" />
    <!-- Pinned to the Tesserae the Curiosity packages above were built against, so the
         pre-transpiled Curiosity modules and this project agree on every component. -->
    <PackageReference Include="Tesserae"                 Version="2026.11.73601" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
